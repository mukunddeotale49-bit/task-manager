# ==========================================
# Environment Variables Template
# Copy to .env and fill in your values
# ==========================================

NODE_ENV=production
BACKEND_PORT=5000
FRONTEND_PORT=80

# AWS RDS MySQL Configuration (replace DB_HOST with your RDS Endpoint)
DB_HOST=your-rds-instance.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=replace_with_your_rds_password
DB_NAME=taskmanager
DB_SSL=true

# Allowed frontend origin (replace with http://<YOUR_EC2_PUBLIC_IP> or http://localhost:8080 locally)
CORS_ORIGIN=http://localhost:8080
